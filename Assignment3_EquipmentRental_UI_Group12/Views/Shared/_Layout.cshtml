<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"] - Assignment3_EquipmentRental_Group12</title>
	<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/Assignment3_EquipmentRental_UI_Group12.styles.css" asp-append-version="true" />
</head>
<body>
	<header>
		<nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-#f6bd60 border-bottom box-shadow mb-3">
			<div class="container-fluid">
				<a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Assignment3_EquipmentRental_Group12</a>
				<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
						aria-expanded="false" aria-label="Toggle navigation">
					<span class="navbar-toggler-icon"></span>
				</button>
				<div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
					<ul class="navbar-nav flex-grow-1">
						<li class="nav-item">
							<a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
						</li>
						<li class="nav-item">
							<a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="About">About</a>
						</li>
					</ul>
					@* place login/logout controls here *@
					<ul class="navbar-nav">
						@if (User.Identity?.IsAuthenticated == true)
						{
							<li class="nav-item">
								<form class="form-inline" asp-controller="Auth" asp-action="Logout" method="post">
									@Html.AntiForgeryToken()
									<input type="submit" class="nav-link btn btn-link text-white" value="Logout (@User.Identity.Name)" />
								</form>
							</li>
						}
						else
						{
							<li class="nav-item">
								<a class="nav-link text-white" asp-controller="Auth" asp-action="Login">Sign in with Google</a>
							</li>
						}
					</ul>
				</div>
			</div>
		</nav>
	</header>
	<div class="container">
		<main role="main" class="pb-3">
			@* Check if there is a last action message in TempData *@
			@* If a message is set in TempData["LastActionMessage"] from the controller, it will be displayed here *@
			@if (TempData.ContainsKey("LastActionMessage"))
			{
				@* Display Bootstrap success alert box (green, dismissible) *@
				<div class="alert alert-success alert-dismissible fade show" role="alert">
					@* Output the message stored in TempData *@
					@TempData["LastActionMessage"]
					@* Close button *@
					<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
				</div>
			}
			@* Individual view page content is rendered here (e.g., Index.cshtml) ! *@
			@RenderBody()
		</main>
	</div>

	<footer class="border-top footer text-muted">
		<div class="container">
			&copy; 2025 - Assignment3_EquipmentRental_Group12 - Juhwan Seo (8819123)
		</div>
	</footer>
	<script src="~/lib/jquery/dist/jquery.min.js"></script>
	<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
	<script src="~/js/site.js" asp-append-version="true"></script>
	@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
