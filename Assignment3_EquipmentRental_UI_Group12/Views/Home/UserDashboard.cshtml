@{
	ViewData["Title"] = "User Dashboard";
}

@* User Dashboard - Display user information and welcome message *@
<div class="centered-content-container">
	<div class="content-box">
		<h3 class="mb-3 about-title">Welcome, @ViewBag.UserName!</h3>
		<p class="mb-4 about-subtitle">User Dashboard</p>
		
		<div class="about-info-card">
			<div class="info-item">
				<strong>Name:</strong>
				<span>@ViewBag.UserName</span>
			</div>
			<div class="info-item">
				<strong>Email:</strong>
				<span>@ViewBag.Email</span>
			</div>
			<div class="info-item">
				<strong>Role:</strong>
				<span class="role-badge role-user">@ViewBag.Role</span>
			</div>
		</div>

		<div class="mt-4">
			<p class="dashboard-message">You have access to equipment rental services.</p>
		</div>
	</div>
</div>
